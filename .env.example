# =============================================================================
# WikiMastered — copier en .env et remplir. Les lignes commentées gardent leur
# valeur par défaut. Listes : JSON ["UR","L"] ou CSV UR,L. Dicts : JSON. Heures : HH:MM.
# =============================================================================

# --- 1. OBLIGATOIRE ----------------------------------------------------------------
# Simule toutes les écritures (enchères, ventes, défausses, ouvertures de paquets).
# Ne passer à false qu'après avoir validé les logs / alertes [DRY RUN].
DRY_RUN=true

# En-tête Cookie complet d'une requête /api/ de wiki-masters.com (DevTools > Réseau >
# une requête /api/wikibidous > En-têtes de requête > cookie). Doit contenir
# sb-<ref>-auth-token (éventuellement découpé en .0, .1...). Entre apostrophes.
WM_COOKIE='sb-xxxxxxxxxxxxxxxxxxxx-auth-token=base64-...'

# User-Agent du navigateur qui a produit le cookie (même requête).
WM_USER_AGENT='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36'

# Ton identifiant joueur (UUID). Déduit du cookie si vide ; `python -m src.main check` l'affiche.
# Sert à ne jamais enchérir sur tes propres ventes.
WM_USER_ID=

# Webhook Discord (Paramètres du salon > Intégrations > Webhooks).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Optionnel : salon séparé pour les alertes critiques (session, 429, tendances) + mention.
# DISCORD_ALERT_WEBHOOK_URL=
# DISCORD_MENTION=@here

# Contact exigé par la politique Wikimedia pour l'API Pageviews (module E).
WIKIMEDIA_USER_AGENT='WikiMasteredBot/1.0 (https://github.com/<toi>/WikiMastered; <ton-email>)'

# --- 2. Session (optionnel) ---------------------------------------------------------
# WM_BASE_URL=https://www.wiki-masters.com
# WM_AUTHORIZATION=                     # seulement si tes requêtes portent un en-tête Authorization
# WM_EXTRA_HEADERS={}                   # en-têtes en plus, JSON (parse_curl --env le remplit)

# --- 3. Réseau / anti-ban -------------------------------------------------------------
# HTTP_MIN_SPACING_SECONDS=1.5          # écart minimum entre deux requêtes (tous workers confondus)
# HTTP_JITTER_SECONDS=0.8               # + aléa 0..x s
# HTTP_TIMEOUT_SECONDS=20
# BACKOFF_BASE_SECONDS=30               # 5xx : 30 s, 60 s, 120 s... jusqu'à BACKOFF_MAX_SECONDS
# BACKOFF_RATE_LIMIT_BASE_SECONDS=60    # 429 : 60 s, 120 s...
# BACKOFF_MAX_SECONDS=900
# SESSION_RECHECK_MINUTES=15            # après un 401/403, re-test de la session

# --- 4. Workers ---------------------------------------------------------------------
# ENABLE_PACK_OPENER=true
# ENABLE_SNIPER=true
# ENABLE_INVENTORY=true                 # publie les ventes programmées ; scans auto via AUTO_*
# ENABLE_WIKI_TRENDS=true
# DAILY_REPORT_TIME=23:00
# NOTIFY_EACH_BID=false                 # true = un message Discord par enchère (très bavard)
# NOTIFY_DIGEST_MINUTES=60              # résumé des enchères toutes les N minutes

# --- 5. Module B : paquets ----------------------------------------------------------
# PACK_OPEN_MIN_STOCK=1                 # ouvrir dès N paquets disponibles (10 max en stock)
# PACK_DELAY_MIN_SECONDS=15             # délai aléatoire après la disponibilité théorique
# PACK_DELAY_MAX_SECONDS=60
# PACK_NOTIFY_RARITIES=UR,L
# PACK_NOTIFY_SHINY=true
# PACK_VERIFICATION_RECHECK_MINUTES=30

# --- 6. Cotes -----------------------------------------------------------------------
# PRICE_CACHE_TTL_MINUTES=180            # la route des cotes est limitée par le site
# PRICE_MIN_SALES=3                     # ventes minimum pour qu'une cote soit fiable

# --- 7. Module D : sniper -----------------------------------------------------------
# SNIPER_POLL_MIN_SECONDS=2.5
# SNIPER_POLL_MAX_SECONDS=4.0
# SNIPER_WINDOW_SECONDS=20              # miser s'il reste moins de X s
# SNIPER_RARITY_CAPS={"SR": 15, "UR": 40, "L": 120}   # mise finale max par rareté
# SNIPER_SHINY_CAP=50
# SNIPER_DEAL_RATIO_MAX=0.45            # mise ≤ 45 % de la cote moyenne
# SNIPER_MAX_BID=300                    # garde-fou absolu par enchère
# SNIPER_DAILY_BUDGET=300               # WikiBidous engagés max par jour
# SNIPER_MIN_BALANCE_RESERVE=50         # solde jamais descendu sous ce seuil
# SNIPER_ALLOW_REBID=true
# SNIPER_MAX_CONCURRENT_BIDS=5          # le site limite à 5 enchères simultanées (mises manuelles comprises)

# Arbitrage nocturne (heure de Paris)
# NIGHT_START=02:00
# NIGHT_END=07:30
# NIGHT_DEAL_RATIO_MAX=0.60
# NIGHT_CAPS_MULTIPLIER=1.3
# NIGHT_WINDOW_SECONDS=45
# NIGHT_BUDGET_BONUS=200

# --- 8. Module C : inventaire -------------------------------------------------------
# INVENTORY_INTERVAL_MINUTES=360
# AUTO_LIST=false                       # mise en vente automatique (sinon : CLI inventory list)
# SELL_MIN_VALUE=15
# SELL_KEEP_COPIES=1                    # exemplaires toujours gardés par carte
# SELL_PRICE_MULTIPLIER=1.0             # prix de départ = cote × multiplicateur
# SELL_MAX_LISTINGS_PER_RUN=5             # le site limite à 5 ventes simultanées
# LISTING_END_WINDOW_START=20:00
# LISTING_END_WINDOW_END=22:30
# LISTING_DURATION_OPTIONS=             # durées acceptées par le site, en minutes (ex. 60,360,720,1440)
# LISTING_MIN_DURATION_MINUTES=60
# ARBITRAGE_RELIST_END_TIME=21:00
# ARBITRAGE_MARKUP=1.0

# AUTO_DISCARD=false
# DISCARD_RARITIES=C,PC
# DISCARD_MAX_VALUE=2                   # cote ≤ 2 WB = sans valeur marchande
# DISCARD_KEEP_COPIES=1
# DISCARD_UNKNOWN_PRICE_IS_WORTHLESS=false
# Paliers de succès « taille de collection » (sans eux, aucune défausse n'est faite).
# ACHIEVEMENT_MILESTONES=100,250,500,1000,2500,5000
# ACHIEVEMENT_COUNT_MODE=total          # total = exemplaires, unique = cartes distinctes
# ACHIEVEMENT_MARGIN=50

# --- 9. Module E : tendances --------------------------------------------------------
# TRENDS_INTERVAL_MINUTES=60
# TRENDS_TOP_N=100
# TRENDS_SPIKE_RATIO=3.0
# TRENDS_MIN_DAILY_VIEWS=2000
# TRENDS_RARITY_THRESHOLDS={"L": 20000}
# TRENDS_SEARCH_LIMIT=15
# TRENDS_MAX_PRICE=30
# TRENDS_AUTO_BUY=false
# TRENDS_AUTO_BUY_MAX=20
