# =============================================================================
# WikiMastered : ./installer.sh remplit ce fichier pour toi (copié en .env).
# À la main : cp .env.example .env, puis remplis les 3 lignes de la partie 1.
# Guide : docs/INSTALLATION.md. Tous les autres réglages : docs/REGLAGES.md.
# Une ligne commentée (#) montre la valeur par défaut ; « ex. » signale un exemple.
# =============================================================================

# --- 1. À REMPLIR ---------------------------------------------------------------------
# Session du bot, prise dans une FENÊTRE PRIVÉE (docs/INSTALLATION.md, étape 1).
# Cookie complet (il contient sb-…-auth-token) et user-agent de la même requête, entre apostrophes.
WM_COOKIE='sb-xxxxxxxxxxxxxxxxxxxx-auth-token=base64-...'
WM_USER_AGENT='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36'
# Webhook du salon Discord où le bot écrit (Modifier le salon > Intégrations > Webhooks).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- 2. Simulation --------------------------------------------------------------------
# true : rien n'est envoyé au site, le bot annonce ce qu'il ferait ([DRY RUN]).
# Passer en réel par étapes : docs/INSTALLATION.md, « Passer en réel ».
DRY_RUN=true
# SIMULATE=                             # avec DRY_RUN=false : ce qui reste simulé, ex. sniper

# --- 3. Ce que fait le bot (rien tant que c'est vide) ---------------------------------
# SNIPER_RESALE_RARITIES=               # raretés achetées pour revendre, ex. SR
# SNIPER_MAX_BID=500                    # mise maximale, en WB
# COLLECTION_SETS=                      # collections à compléter, ex. jours,gifs
# COLLECTION_MAX_PRICE=10               # mise maximale pour une carte de collection
# PROTECTED_TAGS=                       # étiquettes jamais vendues ni défaussées, ex. date,GIF
# AUTO_LIST=false                       # vente automatique des doublons

# --- 4. Discord, facultatif (docs/INSTALLATION.md, « Commandes Discord et salons ») ---
# DISCORD_ALERT_WEBHOOK_URL=            # salon des alertes rouges, le seul à laisser sonner
# DISCORD_BOT_TOKEN=                    # commandes /bilan, /etat, /snipe…
# DISCORD_OWNER_ID=                     # ton identifiant Discord (un nombre)
# DISCORD_GUILD_ID=                     # identifiant du serveur
