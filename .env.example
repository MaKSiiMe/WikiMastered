# =============================================================================
# WikiMastered — copier en .env et remplir. Les lignes commentées gardent leur
# valeur par défaut. Listes : JSON ["UR","L"] ou CSV UR,L. Dicts : JSON. Heures : HH:MM.
# =============================================================================

# --- 1. OBLIGATOIRE -------------------------------------------------------------------
# Simule toutes les écritures (enchères, ventes, défausses, ouvertures de paquets).
# Ne passer à false qu'après avoir validé les messages [DRY RUN] (voir docs/PORTAINER.md, étape 5).
DRY_RUN=true
# Réel / simulé worker par worker. Groupes : sniper (mises des positions), collection (mises du
# mode collection), packs, ventes, defausse, tags, inventory (= ventes + defausse).
# Avec DRY_RUN=true : LIVE_WRITES liste ce qui est quand même réel (ex. packs).
# Avec DRY_RUN=false : SIMULATE liste ce qui reste simulé (ex. sniper : tout le reste est réel).
# LIVE_WRITES=
# SIMULATE=

# En-tête Cookie complet d'une requête /api/ de wiki-masters.com (DevTools > Réseau >
# une requête /api/wikibidous > En-têtes de requête > cookie). Doit contenir
# sb-<ref>-auth-token (éventuellement découpé en .0, .1...). Entre apostrophes.
WM_COOKIE='sb-xxxxxxxxxxxxxxxxxxxx-auth-token=base64-...'

# User-Agent du navigateur qui a produit le cookie (même requête).
WM_USER_AGENT='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36'

# Ton identifiant joueur (UUID). Déduit du cookie si vide ; `python -m src.main check` l'affiche.
# Sert à ne jamais enchérir sur tes propres ventes.
WM_USER_ID=

# Webhook Discord (Paramètres du salon > Intégrations > Webhooks).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Optionnel : salon séparé pour les alertes rouges (session, 429, vérification des paquets) + mention.
# DISCORD_ALERT_WEBHOOK_URL=
# Salon d'activité (paquets, digests, récaps périodiques, tendances, simulé) ; vide = salon principal, off = logs
# DISCORD_ACTIVITY_WEBHOOK_URL=
# DISCORD_MENTION=@here

# Contact exigé par la politique Wikimedia pour l'API Pageviews (tendances Wikipédia).
WIKIMEDIA_USER_AGENT='WikiMasteredBot/1.0 (https://github.com/<toi>/WikiMastered; <ton-email>)'

# --- 2. Session (optionnel) -----------------------------------------------------------
# WM_BASE_URL=https://www.wiki-masters.com
# WM_AUTHORIZATION=                     # seulement si tes requêtes portent un en-tête Authorization
# WM_EXTRA_HEADERS={}                   # en-têtes en plus, JSON (parse_curl --env le remplit)

# Le bot renouvelle sa session Supabase lui-même (voir docs/PORTAINER.md, étape 1).
# Clé publique : DevTools > Réseau > requête vers *.supabase.co > en-tête `apikey`.
# Donne au bot SA PROPRE session (fenêtre privée), sinon ton navigateur l'invalide.
# SUPABASE_ANON_KEY=
# SUPABASE_URL=                         # vide = https://<ref>.supabase.co (ref lu dans le cookie)
# SESSION_REFRESH_MARGIN_MINUTES=10     # renouvellement N minutes avant l'expiration du jeton

# --- 3. Réseau / anti-ban -------------------------------------------------------------
# HTTP_MIN_SPACING_SECONDS=1.5          # écart minimum entre deux requêtes (tous workers confondus)
# HTTP_JITTER_SECONDS=0.8               # + aléa 0..x s
# HTTP_TIMEOUT_SECONDS=20
# BACKOFF_BASE_SECONDS=30               # 5xx : 30 s, 60 s, 120 s... jusqu'à BACKOFF_MAX_SECONDS
# BACKOFF_RATE_LIMIT_BASE_SECONDS=60    # 429 : 60 s, 120 s...
# BACKOFF_MAX_SECONDS=900
# SESSION_RECHECK_MINUTES=15            # après un 401/403, re-test de la session

# --- 4. Workers -----------------------------------------------------------------------
# ENABLE_PACK_OPENER=true
# ENABLE_SNIPER=true
# ENABLE_INVENTORY=true                 # publie les ventes programmées ; scans auto via AUTO_*
# ENABLE_WIKI_TRENDS=true
# ENABLE_GOOGLE_TRENDS=true
# ENABLE_ACHIEVEMENTS=true              # réclame les succès débloqués (SUPABASE_ANON_KEY requise)
# ACHIEVEMENTS_TIME=22:50               # une fois par jour, avant le bilan de 23:00
# DAILY_REPORT_TIME=23:00
# RECAP_INTERVAL_HOURS=4                # récap des workers toutes les N heures (0 = aucun)
# NOTIFY_EACH_BID=false                 # true = un message Discord par enchère (très bavard)
# NOTIFY_DIGEST_MINUTES=60              # résumé des enchères toutes les N minutes
# LOG_LEVEL=INFO

# --- 5. Paquets -----------------------------------------------------------------------
# PACK_OPEN_MIN_STOCK=1                 # ouvrir dès N paquets disponibles (10 max en stock)
# PACK_INTERVAL_MIN_MINUTES=15          # une session d'ouverture toutes les 15 à 90 min (au hasard)
# PACK_INTERVAL_MAX_MINUTES=90
# PACK_BETWEEN_OPENS_MIN_SECONDS=5      # paquets d'une même session espacés de 5 à 15 s
# PACK_BETWEEN_OPENS_MAX_SECONDS=15
# PACK_NOTIFY_RARITIES=UR,L
# PACK_NOTIFY_SHINY=true
# PACK_RETRY_MIN_MINUTES=5              # ouverture échouée (vérification, refus) : nouvel essai dans 5 à 10 min
# PACK_RETRY_MAX_MINUTES=10

# --- 6. Estimation des prix -----------------------------------------------------------
# Le prix suit les tendances (actu, pop culture, mèmes) et la moyenne du site peut être
# très datée. Estimation = médiane des ventes que le bot a lui-même observées (il voit
# toutes les fins d'enchères), plafonnée par la moyenne du site.
# PRICE_RECENT_SALES=5                  # nombre de ventes observées récentes prises en compte
# PRICE_MIN_SALES=2                     # ventes observées minimum avant d'acheter une carte
# SNIPER_MIN_CONTESTED_SALES=3          # parmi elles, ventes disputées (plus d'une mise) minimum pour acheter
# SNIPER_MAX_PRICE_SPREAD=2.0           # et la plus haute ≤ 2 × la plus basse (0 = sans limite)
# PRICE_CACHE_TTL_MINUTES=180            # cache de la moyenne du site (route limitée)

# --- 7. Sniper orienté capital --------------------------------------------------------
# Le bot n'achète que pour revendre, et peu mais gros : chaque achat est une « position »
# qui occupera une des 5 places de vente.
# PORTFOLIO_SLOTS=5                     # = places de vente simultanées du site
# PORTFOLIO_MAX_POSITIONS=15            # plafond absolu : positions détenues + enchères du bot
# PORTFOLIO_BUFFER=10                   # positions en file d'attente au-delà des places de vente libres
# PORTFOLIO_QUEUE_PROFIT_RATIO=0.5      # une position qui devra attendre exige ≥ 50 % du budget (~270 WB)
# PORTFOLIO_CAPITAL_RATIO=0.9           # budget d'une position = capital × 0,9 / 5 (~540 WB pour 3000)
# PORTFOLIO_MIN_PROFIT_RATIO=0.25       # bénéfice attendu ≥ 25 % de ce budget (~135 WB)
# PORTFOLIO_MIN_PROFIT=30               # plancher absolu du bénéfice attendu
# SALE_FEE_PCT=0.0                      # commission du site sur une vente, si elle existe
# POSITION_LIST_PROFIT_SHARE=0.5        # prix de départ de la revente = achat + 50 % du bénéfice attendu
# POSITION_LIST_MARGIN=0.15             # ... et au moins achat + 15 %
# POSITION_POST_NOW=true                # revente publiée dès l'arrivée de la carte (false : 11:00-12:00)
# POSITION_LIST_DURATION_MINUTES=360    # durée de la revente d'une position (6 h)
# POSITION_LIST_LONG_MINUTES=720        # … 12 h tant que moins de POSITION_LIST_LONG_BELOW positions sont détenues
# POSITION_LIST_LONG_BELOW=5            # 0 = toujours 6 h
# POSITION_RELIST_DISCOUNT=0.9          # invendue : remise en vente à -10 %
# POSITION_MAX_RELISTS=2                # puis au prix d'achat tant qu'une place est libre

# SNIPER_POLL_MIN_SECONDS=2.5
# SNIPER_POLL_MAX_SECONDS=4.0
# SNIPER_RESALE_RARITIES=UR,L           # raretés repérées et revendues (les jours manquants : toutes)
# SNIPER_DISCOVERY_SECONDS=10           # nouvelles ventes de chaque rareté repérée, toutes les N s
# SNIPER_OBSERVE_SECONDS=30             # ventes tout juste terminées (prix observés), toutes les N s
# COLLECTION_SEARCH_SECONDS=30          # recherche d'un jour manquant sur le marché toutes les N s
# SNIPER_WINDOW_SECONDS=20              # miser s'il reste moins de X s
# SNIPER_MIN_SECONDS_LEFT=11            # ... mais jamais dans les 10 dernières (prolongation de 60 s)
# SNIPER_DEAL_RATIO_MAX=0.70            # mise ≤ 70 % de l'estimation, en plus du bénéfice minimum
# SNIPER_MIN_BID_SHARE=0.40             # mise < 40 % de l'estimation : position sautée (quota anti-bot gardé)
# SNIPER_ANTIBOT_RETRY_SECONDS=300     # vérification anti-bot en attente : une mise tentée toutes les N s (0 = chacune)
# SNIPER_PREFETCH_SECONDS=8             # estimation anticipée d'une enchère toutes les N s
# SNIPER_MIN_BALANCE_RESERVE=50         # solde jamais descendu sous ce seuil
# SNIPER_MAX_BID=0                      # plafond absolu par enchère (0 = aucun)
# SNIPER_DAILY_BUDGET=0                 # budget quotidien (0 = aucun)
# Achat « collection » par rareté (désactivé) : cartes gardées, jamais revendues.
# SNIPER_RARITY_CAPS={}                 # ex. {"L": 200}
# SNIPER_SHINY_CAP=0
# SNIPER_ALLOW_REBID=true
# SNIPER_LIVE_START=23:00               # mises réelles des positions seulement de START à END (Paris),
# SNIPER_LIVE_END=09:00                 # simulées en dehors ; la collection reste réelle. Absentes ou vides = toujours
# SNIPER_BID_PUSH=0.5                   # mise = minimum + 50 % de l'écart jusqu'au plafond ; surenchérie : plafond
# SNIPER_AVOID_MY_BIDS=true             # le bot ignore les cartes sur lesquelles tu mises (tes collections)
# SNIPER_MAX_CONCURRENT_BIDS=0          # limite volontaire d'enchères en cours (0 = illimité, comme le site)

# Arbitrage nocturne (heure de Paris)
# NIGHT_START=02:00
# NIGHT_END=07:30
# NIGHT_DEAL_RATIO_MAX=0.80
# NIGHT_CAPS_MULTIPLIER=1.3
# NIGHT_WINDOW_SECONDS=20
# NIGHT_BUDGET_BONUS=0

# --- 8. Inventaire : ventes et défausse -----------------------------------------------
# INVENTORY_INTERVAL_MINUTES=360
# AUTO_LIST=false                       # mise en vente automatique (sinon : CLI inventory list)
# SELL_MIN_VALUE=15
# SELL_KEEP_COPIES=1                    # exemplaires toujours gardés par carte
# SELL_LAST_COPY_RARITIES=              # vendues même en dernier exemplaire (ex. L), hors cartes achetées par le bot
# SELL_PRICE_MULTIPLIER=1.0             # prix de départ = cote × multiplicateur
# SELL_MAX_LISTINGS_PER_RUN=5             # le site limite à 5 ventes simultanées
# SELL_ANYTIME=true                     # doublons vendus dès qu'une place se libère (sinon : fin 20:00-22:30)
# SELL_CHECK_MINUTES=10                 # vérification des places libres
# SELL_PRICE_LOOKUPS_PER_RUN=60         # cotes demandées au site par passage ; le reste : ventes observées
# LISTING_END_WINDOW_START=20:00
# LISTING_END_WINDOW_END=22:30
# LISTING_DURATION_OPTIONS=10,30,60,180,360,720,1440   # durées du formulaire de vente du site
# LISTING_PREFERRED_DURATION_MINUTES=360  # durée visée (la plus proche possible finissant dans la fenêtre)
# LISTING_MIN_DURATION_MINUTES=60

# PROTECTED_TAGS=date                   # étiquettes du site jamais vendues ni défaussées (tes collections)

# AUTO_DISCARD=false
# DISCARD_RARITIES=C,PC
# DISCARD_MAX_VALUE=2                   # cote ≤ 2 WB = sans valeur marchande
# DISCARD_KEEP_COPIES=1
# DISCARD_UNKNOWN_PRICE_IS_WORTHLESS=false
# Raretés défaussées même en dernier exemplaire (la carte quitte ta collection) : seulement une carte déjà cotée par
# l'analyse de valeur, sans aucune vente connue au-dessus de DISCARD_MAX_VALUE. Vide = jamais.
# DISCARD_LAST_COPY_RARITIES=C,PC
# DISCARD_MAX_PER_RUN=250               # exemplaires défaussés par passage (INVENTORY_INTERVAL_MINUTES) ; 0 = sans limite
# Paliers de succès « taille de collection » (sans eux, aucune défausse n'est faite).
# ACHIEVEMENT_MILESTONES=100,250,500,1000,2500,5000
# ACHIEVEMENT_COUNT_MODE=total          # total = exemplaires, unique = cartes distinctes
# ACHIEVEMENT_MARGIN=50

# Cartes de valeur de l'inventaire, derniers exemplaires compris (la vente auto ne vend que des doublons).
# ENABLE_VALUE_SCAN=true
# VALUE_SCAN_HOURS=12                   # une analyse toutes les N heures
# VALUE_SCAN_MIN_VALUE=100              # cote minimale d'une carte signalée sur Discord
# VALUE_SCAN_LOOKUPS=0                  # cotes demandées au site par passage (0 = toutes)
# VALUE_SCAN_LOOKUP_SECONDS=3           # au mieux une cote toutes les N s, en fond (ralentit si le site refuse)
# VALUE_SCAN_MAX_AGE_DAYS=7             # cote plus récente : reprise du cache, pas redemandée
# VALUE_SCAN_UNSOLD_DAYS=30             # carte sans aucune vente : recotée après N jours
# VALUE_SCAN_FREEZE_BELOW=50            # cotée sous N WB : cote figée pour toujours (0 = jamais)
# VALUE_TAG_TIERS=1000,500,100         # étiquette un exemplaire de chaque carte de valeur par palier (vide = non) ;
#                                     # cet exemplaire n'est plus vendu ni défaussé
# VALUE_TAG_NAME=💎 {}+                 # nom des étiquettes, {} = le palier
# VALUE_WATCH_MIN=500                   # cartes cotées au moins N WB cherchées sur le marché (0 = non)
# VALUE_WATCH_MINUTES=60                # une recherche de chacune toutes les N minutes, en fond
# VALUE_SELL_MIN=1000                   # carte surveillée cotée au moins N WB : mise en vente, une à la fois (0 = non)
# VALUE_SELL_SHARE=0.6                  # prix de départ : part de la cote, jamais sous la plus haute mise vue
# VALUE_SELL_MINUTES=360                # durée de chaque vente
# VALUE_SELL_EXCLUDE=                   # titres jamais vendus (CSV ou JSON), ex. Manifestations du 17 octobre 2026

# --- 9. Tendances Wikipédia -----------------------------------------------------------
# Les cartes signalées par les tendances sont enregistrées et mesurées (bilan du dimanche,
# `python -m src.main trends`), sans message Discord.
# TRENDS_NOTIFY=false                   # true = un message par passage (Wikipédia et Google)
# TRENDS_INTERVAL_MINUTES=60
# TRENDS_TOP_N=100
# TRENDS_SPIKE_RATIO=3.0
# TRENDS_MIN_DAILY_VIEWS=2000
# TRENDS_RARITY_THRESHOLDS={"L": 20000}
# TRENDS_SEARCH_LIMIT=15
# TRENDS_MAX_PRICE=0                    # 0 = budget d'une position (~590 WB pour 3300 WB)
# TRENDS_AUTO_BUY=false
# TRENDS_AUTO_BUY_MAX=20

# --- 10. Google Trends (recherches en hausse en France, flux RSS public) --------------
# Le flux ne garde que la dernière heure environ : lu toutes les 20 min.
# GOOGLE_TRENDS_GEO=FR
# GOOGLE_TRENDS_INTERVAL_MINUTES=20
# GOOGLE_TRENDS_MIN_TRAFFIC=0           # ignorer les termes sous N recherches (ex. 500)

# --- 11. Collection (cartes gardées, jamais revendues) --------------------------------
# COLLECTION_SETS=jours                 # les 366 jours de l'année (« 1er janvier », « 14 octobre »…)
# COLLECTION_TITLES=                    # titres exacts en plus, séparés par des virgules
# COLLECTION_MAX_PRICE=50               # mise maximale pour une carte manquante
# COLLECTION_BIDS_PER_CHECK=2           # mises de collection par vérification anti-bot (~9-10 mises) ; 0 = sans limite
# COLLECTION_REFRESH_MINUTES=360        # relecture de la collection
# COLLECTION_TAG=date                   # étiquette ajoutée à un exemplaire de chaque carte possédée (vide = non)
# COLLECTION_TAG_MAX_PER_RUN=60
